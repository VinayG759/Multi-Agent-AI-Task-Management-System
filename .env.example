# Copy this file to .env and fill in the two keys.
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=

# Recommended. When set, a new person must send "/start <code>" to the bot before they can use it.
# Leave it empty and anyone who finds the bot can read tasks and use your API credits.
TEAM_JOIN_CODE=

# Set both of these when the app runs on a public address (see "Deploy" in the README).
# Setting DASHBOARD_PASSWORD turns on the sign-in page for the dashboard and API.
# DASHBOARD_USERNAME is the username to sign in with (default: admin).
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# SEED_DEMO_DATA=true reloads the demo team and tasks whenever the database is empty.
SEED_DEMO_DATA=false

# Optional. Defaults shown.
DATABASE_URL=sqlite+aiosqlite:///./tasks.db
TIMEZONE=Asia/Kolkata
ENABLE_TELEGRAM=true
ENABLE_SCHEDULER=true
